# Copy this file to /home/gabernardi/.config/ib-gateway-paper.env and fill in real values.
# The real env file should be chmod 600 and must not be committed.

TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password

# Optional but strongly recommended so you can inspect the gateway over an SSH tunnel.
# Example tunnel from your laptop: ssh -L 5900:127.0.0.1:5900 openclaw-bot
VNC_SERVER_PASSWORD=change_me_to_a_strong_password

# Optional: set if you want IBC to target a particular 2FA device.
# TWOFA_DEVICE=
